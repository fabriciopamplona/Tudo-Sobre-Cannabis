# Copie para .env.local (não commitar segredos).
# Na Vercel: só SITE_URL + NEXT_PUBLIC_GA_MEASUREMENT_ID (ver docs/OPS-LIVE.md).

# URL canônica do site (sitemap, robots, metadataBase, OG)
SITE_URL=https://tudosobrecannabis.com

# GA4 Measurement ID (tag no site público)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-36CZW66Q3C

# ——— só localhost (npm run dev) ———
# /admin e /esteira → 404 no domínio público.
# ADMIN_PASSWORD=tsc-local
# LOOKER_STUDIO_URL=https://lookerstudio.google.com/reporting/...

# Sync automático GA4 + GSC (ver docs/ADMIN.md)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/tsc-analytics.json
# GA4_PROPERTY_ID=123456789
# GSC_SITE_URL=https://tudosobrecannabis.com/
# ADMIN_ANALYTICS_TTL_HOURS=6
# ADMIN_ANALYTICS_PERIOD_DAYS=28
