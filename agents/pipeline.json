{
  "name": "editorial-pipeline",
  "pattern": "sequential-with-evaluator-gates",
  "language": "pt-BR",
  "humanApprovalBeforePublish": true,
  "artifactRoot": "content/runs",
  "publishRoot": "content/published",
  "channelRoots": {
    "blog": "content/published",
    "medium": "content/medium",
    "newsletter": "content/newsletter"
  },
  "maxRetriesPerStage": 2,
  "providers": {
    "scrap": "deepseek",
    "write": "claude"
  },
  "workflow": {
    "columns": [
      {
        "id": "inbox",
        "label": "Inbox",
        "description": "Ideia."
      },
      {
        "id": "queued",
        "label": "Fila",
        "description": "Pronta para rodar."
      },
      {
        "id": "in_pipeline",
        "label": "Esteira",
        "description": "Brief → pack → texto → SEO → ilustras → audit/SERP."
      },
      {
        "id": "gate",
        "label": "Gate",
        "description": "OK humano único (publish)."
      },
      {
        "id": "approved",
        "label": "Aprovado",
        "description": "Staging raro; no painel aparece no Gate."
      },
      {
        "id": "published",
        "label": "No ar",
        "description": "Publicado."
      },
      {
        "id": "out",
        "label": "Fora",
        "description": "Arquivo / nao-escrever."
      }
    ],
    "ticks": [
      {
        "id": "scrap",
        "order": 0,
        "artifact": "guide.md",
        "agent": "scraper",
        "provider": "deepseek",
        "optional": true,
        "doneWhen": "Claims extraídos. URL C&S/Sechat não vai ao HTML."
      },
      {
        "id": "briefed",
        "order": 1,
        "artifact": "00-brief.md",
        "agent": "strategist",
        "provider": "claude",
        "doneWhen": "action, takeaway, type, canal, autor, teto de opinião."
      },
      {
        "id": "researched",
        "order": 2,
        "artifact": "01-research-pack.md",
        "agent": "researcher",
        "provider": "claude",
        "doneWhen": "Allowlist; LACUNA honesta; especialidade ≠ diagnóstico."
      },
      {
        "id": "draft",
        "order": 3,
        "artifact": "02-draft.md",
        "agent": "writer",
        "provider": "claude",
        "doneWhen": "Registro do brief; fato só do pack."
      },
      {
        "id": "humanized",
        "order": 4,
        "artifact": "03-humanized.md",
        "agent": "humanizer",
        "provider": "claude",
        "doneWhen": "É o artigo, não meta. Sem fato novo."
      },
      {
        "id": "candidate",
        "order": 5,
        "artifact": "04-publish-candidate.md",
        "agent": "seo-editor",
        "provider": "claude",
        "doneWhen": "Title/slug/links no corpo; keyword travada se honesta; fecho hub; handoff para ilustras."
      },
      {
        "id": "illustrations_spec",
        "order": 6,
        "artifact": "05-illustrations-spec.md",
        "agent": "illustrator-spec",
        "provider": "claude+human",
        "gate": "docs/IMAGE-STYLE.md",
        "doneWhen": "Para cada figura: prompt (IMAGE-STYLE + tema + pt-BR na arte), legenda Figura:, alt, title, arquivo alvo. Capa + 2–3 no corpo (hub)."
      },
      {
        "id": "illustrations_render",
        "order": 7,
        "artifact": "04-publish-candidate.md",
        "agent": "illustrator-render",
        "provider": "human+imagegen",
        "doneWhen": "WebP em web/public/illustrations/<slug>/; Figura:/![] no markdown; image: no frontmatter."
      },
      {
        "id": "quality_audit",
        "order": 8,
        "artifact": "06-scores.md",
        "agent": "auditor",
        "provider": "claude",
        "doneWhen": "esteira:audit até factual≥8, editorial≥7, seo≥8.5 (meta≥9)."
      },
      {
        "id": "serp_locked",
        "order": 9,
        "artifact": "07-serp-review.md",
        "agent": "serp-reviewer",
        "provider": "claude",
        "gate": "agents/gates/seo-serp.md",
        "doneWhen": "Busca SERP real; Veredicto SEO: PRONTO. npm run esteira:audit -- --phase serp|finish"
      },
      {
        "id": "gate_prep",
        "order": 10,
        "artifact": "05-gate-prep.md",
        "agent": "gate-prep",
        "provider": "claude",
        "gate": "agents/gates/publish.md",
        "doneWhen": "Checklist preenchido; recomendação APROVAR|AJUSTAR|BLOQUEAR. Humano só OK no publish."
      }
    ],
    "qualityLoop": {
      "command": "npm run esteira:audit",
      "phases": ["audit", "improve", "reaudit", "serp", "gate-prep", "finish"],
      "floors": { "factual": 8, "editorial": 7, "seo": 8.5 },
      "seoTarget": 9,
      "beforeGate": true,
      "afterIllustrations": true,
      "aiBeforeHumanOk": ["06-scores.md", "07-serp-review.md", "05-gate-prep.md"],
      "humanOk": "publish com reviewedBy (OK único; absorve assinatura do gate)",
      "referenceFormat": "docs/REFERENCE-FORMAT.md",
      "imageStyle": "docs/IMAGE-STYLE.md"
    },
    "frontmatterStatuses": [
      "draft",
      "seed-rewrite",
      "published",
      "needs_update",
      "withdrawn"
    ],
    "keywordStatuses": ["none", "candidate", "locked"],
    "id": {
      "field": "id",
      "label": "#",
      "store": "content/opportunities/ledger.json",
      "note": "Número estável da pauta. Não reutiliza. Chat e CLI usam --id / #12."
    },
    "verdicts": ["pending", "BLOQUEAR", "AJUSTAR", "APROVAR"],
    "priorities": ["P0", "P1", "P2", "P3"],
    "origins": ["gsc", "recencia", "radar", "humano", "tese"],
    "scores": [
      {
        "id": "factual",
        "label": "Factual",
        "floorPublish": 8,
        "floorBlockBelow": 7
      },
      {
        "id": "editorial",
        "label": "Editorial",
        "floorPublish": 7
      },
      {
        "id": "seo",
        "label": "SEO on-page",
        "floorCandidate": 5,
        "floorPublish": 8.5,
        "target": 9,
        "note": "Blog: rodar esteira:audit → improve → reaudit até ≥8.5 antes do gate"
      },
      {
        "id": "ranking",
        "label": "Ranking",
        "note": "0 se factual < 7, mesmo com on-page 10"
      }
    ],
    "scoreFiles": ["06-scores.md", "06-claude-review.md"]
  },
  "stages": [
    {
      "id": "scraper",
      "provider": "deepseek",
      "optional": true,
      "system": "agents/scraper/SYSTEM.md",
      "writes": "guide.md",
      "timeoutSec": 120
    },
    {
      "id": "strategist",
      "provider": "claude",
      "system": "agents/strategist/SYSTEM.md",
      "reads": [
        "agents/PROMPT-MESTRE.md",
        "docs/EDITORIAL-VOICE.md",
        "docs/CHANNELS.md",
        "docs/SEO.md",
        "content/taxonomy.json",
        "content/opportunities/search-console.json",
        "content/opportunities/queue.md",
        "content/opportunities/inbox.md",
        "content/opportunities/library.md"
      ],
      "writes": "00-brief.md",
      "timeoutSec": 120
    },
    {
      "id": "researcher",
      "provider": "claude",
      "system": "agents/researcher/SYSTEM.md",
      "reads": ["agents/PROMPT-MESTRE.md", "00-brief.md", "content/sources.json", "content/taxonomy.json", "content/opportunities/search-console.json"],
      "writes": "01-research-pack.md",
      "timeoutSec": 180
    },
    {
      "id": "writer",
      "provider": "claude",
      "system": "agents/writer/SYSTEM.md",
      "reads": [
        "agents/PROMPT-MESTRE.md",
        "00-brief.md",
        "01-research-pack.md",
        "docs/EDITORIAL-VOICE.md",
        "docs/CHANNELS.md",
        "docs/REFERENCE-FORMAT.md",
        "content/examples/VOICE-CORPUS.md"
      ],
      "writes": "02-draft.md",
      "timeoutSec": 180
    },
    {
      "id": "humanizer",
      "provider": "claude",
      "system": "agents/humanizer/SYSTEM.md",
      "reads": [
        "agents/PROMPT-MESTRE.md",
        "00-brief.md",
        "02-draft.md",
        "docs/EDITORIAL-VOICE.md",
        "docs/REFERENCE-FORMAT.md",
        "content/examples/VOICE-CORPUS.md"
      ],
      "writes": "03-humanized.md",
      "timeoutSec": 120
    },
    {
      "id": "seo-editor",
      "provider": "claude",
      "system": "agents/seo-editor/SYSTEM.md",
      "reads": ["agents/PROMPT-MESTRE.md", "00-brief.md", "01-research-pack.md", "03-humanized.md", "docs/SEO.md", "docs/CHANNELS.md", "docs/REFERENCE-FORMAT.md", "docs/IMAGE-STYLE.md", "content/taxonomy.json"],
      "writes": "04-publish-candidate.md",
      "timeoutSec": 120
    },
    {
      "id": "illustrator-spec",
      "provider": "claude",
      "system": "agents/illustrator/SYSTEM.md",
      "reads": ["agents/PROMPT-MESTRE.md", "04-publish-candidate.md", "00-brief.md", "docs/IMAGE-STYLE.md", "docs/visual/kit-moderno/03-ilustracoes/ilustracao-folhas.png", "docs/REFERENCE-FORMAT.md"],
      "writes": "05-illustrations-spec.md",
      "timeoutSec": 120
    },
    {
      "id": "illustrator-render",
      "provider": "human+imagegen",
      "system": "agents/illustrator/RENDER.md",
      "reads": ["05-illustrations-spec.md", "04-publish-candidate.md", "docs/IMAGE-STYLE.md", "docs/visual/kit-moderno/03-ilustracoes/ilustracao-folhas.png"],
      "writes": ["04-publish-candidate.md", "web/public/illustrations/<slug>/"],
      "humanRequired": true
    },
    {
      "id": "auditor",
      "provider": "claude",
      "system": "inline em agents/audit-gate.mjs",
      "writes": ["06-scores.md", "06-audit.json"],
      "command": "npm run esteira:audit"
    },
    {
      "id": "serp-reviewer",
      "provider": "claude",
      "system": "agents/serp-reviewer/SYSTEM.md",
      "reads": ["04-publish-candidate.md", "06-scores.md", "agents/gates/seo-serp.md", "content/taxonomy.json"],
      "writes": "07-serp-review.md",
      "command": "npm run esteira:audit -- --phase serp",
      "timeoutSec": 180
    },
    {
      "id": "gate-prep",
      "provider": "claude",
      "system": "agents/gate-prep/SYSTEM.md",
      "reads": ["04-publish-candidate.md", "06-scores.md", "07-serp-review.md", "agents/gates/publish.md"],
      "writes": "05-gate-prep.md",
      "command": "npm run esteira:audit -- --phase gate-prep",
      "timeoutSec": 120
    },
    {
      "id": "publish-gate",
      "system": "agents/gates/publish.md",
      "humanRequired": true,
      "humanOkOnly": true,
      "note": "Humano só dá OK no publish (reviewedBy). Checklist vem de 05-gate-prep.md + SERP + audit.",
      "writes": "05-gate.md",
      "requiresScores": {
        "factual": 8,
        "editorial": 7,
        "seo": 8.5
      },
      "requiresIllustrations": {
        "spec": "05-illustrations-spec.md",
        "channels": ["blog"]
      },
      "requiresSerpReview": {
        "artifact": "07-serp-review.md",
        "gate": "agents/gates/seo-serp.md",
        "channels": ["blog"],
        "verdict": "PRONTO"
      },
      "requiresGatePrep": {
        "artifact": "05-gate-prep.md",
        "optional": true
      }
    }
  ]
}
