{
  "name": "tudo-sobre-cannabis",
  "private": true,
  "description": "Portal editorial de cannabis medicinal no Brasil",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix web",
    "lint": "npm run lint --prefix web",
    "agent": "node agents/run.mjs",
    "pauta": "node agents/run.mjs --queue",
    "esteira": "node agents/board.mjs",
    "esteira:do": "node agents/actions.mjs",
    "kb": "python3 kb/run.py build",
    "kb:ingest": "python3 kb/run.py ingest",
    "kb:midia": "python3 kb/run.py ingest-midia",
    "kb:pilot": "python3 kb/run.py pilot"
  },
  "engines": {
    "node": ">=20"
  }
}
