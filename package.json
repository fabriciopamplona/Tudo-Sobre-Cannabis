{
  "name": "tudo-sobre-cannabis",
  "private": true,
  "description": "Portal editorial de cannabis medicinal no Brasil",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix web",
    "lint": "npm run lint --prefix web",
    "agent": "node agents/run.mjs",
    "pauta": "node agents/run.mjs --queue",
    "esteira": "node agents/board.mjs",
    "esteira:do": "node agents/actions.mjs",
    "esteira:batch": "node agents/batch-esteira.mjs",
    "esteira:gate": "node agents/batch-ate-gate.mjs",
    "esteira:cron-fila": "node agents/cron-fila-tick.mjs",
    "esteira:cron-fila:finish": "node agents/cron-fila-tick.mjs --finish-pending",
    "esteira:cron-fila:status": "node agents/cron-fila-tick.mjs --status",
    "esteira:cron-fila:sync": "node agents/cron-fila-tick.mjs --sync",
    "esteira:cron-fila:publish": "node agents/cron-fila-publish.mjs",
    "esteira:cron-fila:nightly": "zsh scripts/cron-fila-nightly-arm.sh",
    "esteira:cron-fila:nightly:status": "node agents/cron-fila-tick.mjs --status",
    "esteira:audit": "node agents/audit-gate.mjs",
    "esteira:gate-preflight": "node scripts/gate-preflight.mjs",
    "esteira:fap-score": "node scripts/fap-score.mjs",
    "esteira:evergreen": "node scripts/evergreen-queue.mjs",
    "esteira:evergreen:next": "node scripts/evergreen-queue.mjs --next",
    "esteira:evergreen:due": "node scripts/evergreen-queue.mjs --due",
    "esteira:evergreen:sync": "node scripts/evergreen-queue.mjs --sync",
    "esteira:evergreen:publish": "node scripts/evergreen-queue.mjs --publish",
    "esteira:evergreen:tick": "zsh scripts/evergreen-publish-tick.sh",
    "esteira:evergreen:install": "zsh scripts/evergreen-publish-install.sh",
    "esteira:pack-check": "node agents/pack-freshness.mjs",
    "kb": "python3 kb/run.py build",
    "kb:ingest": "python3 kb/run.py ingest",
    "kb:midia": "python3 kb/run.py ingest-midia",
    "kb:pilot": "python3 kb/run.py pilot"
  },
  "engines": {
    "node": ">=20"
  }
}
