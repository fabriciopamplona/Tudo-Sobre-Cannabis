# Preencha no Replit Secrets ou num .env local. Nunca commite chaves.

# Esteira reprodutiva.
# DeepSeek: só scrap (`npm run agent -- --url ...` → guide.md).
# Escritura: Claude CLI (`claude auth login --claudeai`). Sem API key.
CLAUDE_CLI_MODEL=sonnet

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Opcional: Console Anthropic, se o CLI não estiver logado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

# Opcional: endpoint compatível com OpenAI (OpenRouter, etc.)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1

# SERP (passo 3 da KB). Sem isso, o score usa só o dump.
SERPAPI_API_KEY=

SITE_URL=http://localhost:3000
