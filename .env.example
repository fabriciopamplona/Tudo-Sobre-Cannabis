# Preencha no Replit Secrets ou num .env local. Nunca commite chaves.

# Pelo menos uma das duas para rodar a esteira com modelo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: endpoint compatível com OpenAI (OpenRouter, etc.)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-6

SITE_URL=http://localhost:3000
